---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="jquest.dev - Notes, projects, and experiments" useTitleTemplate={false}>
  <Hero />

  <section class="my-24">
    <div class="container space-content max-w-3xl">
      <Heading level="h2">Hi, I'm Josh</Heading>
      <p class="text-2xl">
        I'm a developer based in Yorkshire, UK. This is my corner of the web for projects and writing.
      </p>
      <p>
        Browse the portfolio for build notes and case studies, or dip into the blog for the latest updates.
      </p>
      <div class="flex flex-wrap gap-4">
        <Link href="/portfolio" isButton type="primary" animateOnHover animationType="boop">
          View projects
        </Link>
        <Link href="/blog" isButton type="secondary" animateOnHover animationType="boop">
          Read the blog
        </Link>
      </div>
    </div>
  </section>

  <FeaturedProjects />
  <FeaturedPosts />

</DefaultLayout>
