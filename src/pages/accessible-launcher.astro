---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Notification } from 'accessible-astro-components'
---

<DefaultLayout title="Launcher">
  <section class="my-12">
    <PageHeader
      title="Launcher"
      subtitle="A quick command palette for jumping between pages, posts, and projects."
      bgType="bordered"
    />
  </section>
  <section class="mt-32 mb-12">
    <div class="narrow container">
      <Notification type="info" variant="accent">
        <p>
          Open the Launcher with <kbd class="kbd">Cmd + K</kbd> (Mac) or <kbd class="kbd">Ctrl + K</kbd> (Windows/Linux).
          It focuses the search input so you can jump fast.
        </p>
      </Notification>
    </div>
  </section>
</DefaultLayout>
