---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

// Get all portfolio projects
const projects = await getCollection('projects')

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'Landing page with the latest projects and writing.',
  },
  {
    title: 'Toolkit',
    url: '/accessible-components',
    description: 'A compact set of UI patterns and component experiments.',
  },
  {
    title: 'Portfolio',
    url: '/portfolio',
    description: 'Selected work and project write-ups.',
  },
  {
    title: 'Blog',
    url: '/blog',
    description: 'Notes on tooling, deployment, and things worth remembering.',
  },
  {
    title: 'Contact',
    url: '/contact',
    description: 'Ways to reach me for collaboration or questions.',
  },
  {
    title: 'Colour Lab',
    url: '/color-contrast-checker',
    description: 'A contrast playground for palette checks.',
  },
  {
    title: 'Notes',
    url: '/markdown-page',
    description: 'Quick markdown space for rough ideas and links.',
  },
  {
    title: 'Experiments',
    url: '/mdx-page',
    description: 'MDX sandbox for layout and component testing.',
  },
  {
    title: 'Launcher',
    url: '/accessible-launcher',
    description: 'Details on the command palette shortcut.',
  },
  {
    title: 'Thank you',
    url: '/thank-you',
    description: 'Confirmation page for contact submissions.',
  },
]
---

<DefaultLayout
  title="Index"
  description="A quick index of pages, projects, and blog posts on this site."
>
  <PageHeader
    title="Index"
    subtitle="Everything in one place, sorted for quick navigation."
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <!-- Main Pages Section -->
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Portfolio Projects Section -->
      <div>
        <Heading level="h2">Portfolio projects</Heading>
        <p class="mb-6">
          Explore {projects.length} projects with short summaries and links to the full write-ups.
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/portfolio/${project.id}`}>{project.data.title}</a>
                </Heading>
                <p class="mb-3">{project.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    By: <span class="font-medium">{project.data.author}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /portfolio/{project.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Blog Section -->
      <div>
        <Heading level="h2" class="mb-6">Blog</Heading>
        <article>
          <Heading level="h3" size="h6" class="mb-3">
            <a href="/blog"> Blog posts </a>
          </Heading>
          <p>
            Notes on shipping, tooling, and the bits worth documenting while building.
          </p>
          <div class="text-xs">
            <p>Base URL: <code
              class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500"
              >/blog</code
            >
            </p>
            <p>
              Individual posts: <code
                class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500"
                >/blog/[post]</code
              >
            </p>
          </div>
        </article>
      </div>

      <!-- Technical Information -->
      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML Sitemap:</span> An automated XML sitemap is generated at
              <code>/sitemap.xml</code>
              for search engine optimization.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap integration configured in astro.config.mjs
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
