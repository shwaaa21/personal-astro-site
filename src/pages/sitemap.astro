---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Notification } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

// Get all vault entries
const projects = await getCollection('projects')

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'Landing page with the latest projects and writing.',
  },
  {
    title: 'Notes',
    url: '/blog',
    description: 'Notes and blobs of stuff.',
  },
  {
    title: 'Vault',
    url: '/vault',
    description: 'Archived projects and experiments with full write-ups.',
  },
  {
    title: 'RSS feed',
    url: '/rss.xml',
    description: 'Subscribe to new notes with any feed reader.',
  },
  {
    title: 'Index',
    url: '/sitemap',
    description: 'A quick index of every page, vault entry, and note on this site.',
  },
]
---

<DefaultLayout
  title="Index"
  description="A quick index of pages, projects, and blog posts on this site."
>
  <PageHeader
    title="Index"
    subtitle="Everything in one place, sorted for quick navigation."
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container space-y-12">
      <!-- Main Pages Section -->
      <div>
        <Heading level="h2" class="mb-6">Main pages</Heading>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            staticPages.map((page) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={page.url}>{page.title}</a>
                </Heading>
                <p class="mb-3">{page.description}</p>
                <p class="text-xs">
                  URL:{' '}
                  <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                    {page.url}
                  </code>
                </p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Vault Section -->
      <div>
        <Heading level="h2">Vault entries</Heading>
        <p class="mb-6">
          Explore {projects.length} archived projects with short summaries and links to the full write-ups.
        </p>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article>
                <Heading level="h3" size="h6" class="mb-3">
                  <a href={`/vault/${project.id}`}>{project.data.title}</a>
                </Heading>
                <p class="mb-3">{project.data.description}</p>
                <div class="text-xs">
                  <p class="mb-1">
                    By: <span class="font-medium">{project.data.author}</span>
                  </p>
                  <p>
                    URL:{' '}
                    <code class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500">
                      /vault/{project.id}
                    </code>
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Blog Section -->
      <div>
        <Heading level="h2" class="mb-6">Blog</Heading>
        <article>
          <Heading level="h3" size="h6" class="mb-3">
            <a href="/blog"> Blog posts </a>
          </Heading>
          <p>
            Notes on shipping, tooling, and the bits worth documenting while building.
          </p>
          <div class="text-xs">
            <p>Base URL: <code
              class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500"
              >/blog</code
            >
            </p>
            <p>
              Individual posts: <code
                class="rounded bg-neutral-100 px-1 py-0.5 text-xs text-neutral-500 dark:bg-neutral-800 dark:text-neutral-500"
                >/blog/[post]</code
              >
            </p>
          </div>
        </article>
      </div>

      <!-- Technical Information -->
      <Notification type="info" variant="accent">
        <div class="space-content">
          <Heading level="h2" size="h6" class="mb-4">Technical sitemap information</Heading>
          <ul>
            <li>
              <span class="font-bold">XML Sitemap:</span> An automated XML sitemap is generated at
              <code>/sitemap.xml</code>
              for search engine optimization.
            </li>
            <li>
              <strong>Generated by:</strong> @astrojs/sitemap integration configured in astro.config.mjs
            </li>
            <li>
              <strong>Last updated:</strong> Automatically updated on each build
            </li>
          </ul>
        </div>
      </Notification>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    background-color: var(--background-color);
    padding: 1rem;
  }
</style>
