---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Form, Input, Button, Textarea, Checkbox, Fieldset, Heading, Link, Radio } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contact">
  <PageHeader title="Contact" subtitle="Got an idea or a project in mind? Let's chat." bgType="gradient" />
  <section class="my-16">
    <div class="container">
      <Heading level="h2">Let's talk</Heading>
    </div>
  </section>
  <section class="container">
    <div class="grid grid-cols-1 gap-32 md:grid-cols-2">
      <div class="space-content">
        <Form name="contact" action="/thank-you" method="post">
          <!-- Input field with custom validation message -->
          <Input
            name="firstname"
            label="First name"
            required
            data-validation="We need your first name to address you correctly"
            autocomplete="given-name"
          />

          <Input name="email" label="Email address" type="email" required autocomplete="email" />

          <!-- Custom validation with pattern -->
          <Input name="phone" label="Phone number" type="tel" required data-validation-pattern="^[0-9]{10}$" />

          <Textarea name="message" label="Message" required />

          <!-- Checkbox group with validation -->
          <Fieldset
            name="interests"
            legend="What are you interested in?"
            required
            data-validation="Please select at least one area of interest"
          >
            <Checkbox name="project" value="project" label="Project collaboration" />
            <Checkbox name="freelance" value="freelance" label="Freelance inquiry" />
            <Checkbox name="questions" value="questions" label="Questions or feedback" />
            <Checkbox name="other" value="other" label="Other" />
          </Fieldset>

          <!-- Radio group (shared names) -->
          <Fieldset name="timeline" legend="Timeline" required>
            <Radio name="timeline" value="soon" label="ASAP" />
            <Radio name="timeline" value="next-month" label="Next month" />
            <Radio name="timeline" value="future" label="Just exploring" />
          </Fieldset>

          <Button htmlType="submit" type="primary">Send Message</Button>
        </Form>
      </div>
      <div class="space-content">
        <Heading level="h3">Contact info</Heading>
        <p class="text-lg">
          The best way to reach me is email. I reply when I'm at my desk, usually within a couple of days.
        </p>
        <p>
          If you're sharing project details, include timelines, scope, and any links that help me understand the work.
        </p>

        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:mail" size={20} class="flex-shrink-0" />
          <p>
            <span class="font-bold">Email:</span>
            <Link href="mailto:josh_dev21@protonmail.com">josh_dev21@protonmail.com</Link>
          </p>
        </div>

        <div class="gap-2xs flex items-center">
          <Icon aria-hidden="true" name="lucide:map-pin" size={20} class="flex-shrink-0" />
          <p>
            <span class="font-bold">Address:</span>
            Yorkshire, UK
          </p>
        </div>

        <ul class="flex flex-wrap gap-2">
          <li>
            <Link href="https://github.com/shwaaa21" isButton isExternal hideIcon animateOnHover animationType="boop">
              <Icon aria-hidden="true" name="lucide:github" size={32} />
              <span class="sr-only">Go to my GitHub page, opens in a new tab</span>
            </Link>
          </li>
        </ul>
      </div>
    </div>
  </section>
</DefaultLayout>
