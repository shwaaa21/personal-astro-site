---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <CallToAction />
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Explore</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/blog">Blog</Link></li>
          <li><Link href="/portfolio">Projects</Link></li>
          <li><Link href="/accessible-components">Toolkit</Link></li>
          <li><Link href="/accessible-launcher">Launcher</Link></li>
          <li><Link href="/color-contrast-checker">Colour Lab</Link></li>
          <li><Link href="/sitemap">Index</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Contact</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/contact">Say hello</Link></li>
          <li><Link href="mailto:josh_dev21@protonmail.com">josh_dev21@protonmail.com</Link></li>
          <li>Yorkshire, UK</li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Elsewhere</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link isExternal href="https://github.com/shwaaa21">GitHub</Link>
          </li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p class="leading-[1.75]">
          Built as a personal space for projects, notes, and experiments.
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} Josh G. Built with <Link href="https://astro.build/">Astro</Link>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
