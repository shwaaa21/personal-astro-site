---
import themeConfig from '@theme-config'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Explore</Heading>
        <ul class="flex flex-col gap-2">
          <li><Link href="/blog">Notes</Link></li>
          <li><Link href="/vault">Vault</Link></li>
          <li><Link href="/rss.xml">RSS feed</Link></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Give me a follow</Heading>
        <ul class="flex flex-col gap-2">
          {
            (themeConfig.socials ?? []).map((social) => (
              <li>
                <Link href={social.href} isExternal>
                  <Icon aria-hidden="true" name={social.icon} size={18} />
                  {social.label}
                </Link>
              </li>
            ))
          }
          <li><Link href="mailto:josh_dev21@protonmail.com">josh_dev21@protonmail.com</Link></li>
        </ul>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} Josh G. Built with <Link href="https://astro.build/">Astro</Link>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
